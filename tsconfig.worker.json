{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true
  },
  "include": [
    "worker/**/*.ts",
    "src/config/**/*.ts",
    "src/core/**/*.ts",
    "src/integrations/**/*.ts"
  ]
}
