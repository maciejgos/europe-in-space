---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Explore Europe's journey into space">
  <p class="mb-5 text-sm font-semibold uppercase tracking-widest text-sky-300">An independent exploration project</p>
  <h1 class="max-w-3xl text-4xl font-bold leading-tight sm:text-6xl">Explore Europe’s journey into space.</h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">Discover the missions, spacecraft and science shaping Europe’s presence beyond Earth. Our first interactive experience is in development.</p>
  <a class="mt-8 inline-block rounded bg-sky-300 px-5 py-3 font-semibold text-slate-950" href="/about/">About the project</a>
</BaseLayout>
