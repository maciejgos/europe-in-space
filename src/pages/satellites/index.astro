---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EarthGlobe from "../../components/satellite-tracker/EarthGlobe.astro";

const description = "Explore Earth from space, starting over Europe.";
---

<BaseLayout title="Satellites" description={description}>
  <EarthGlobe>
    <header slot="intro" class="globe-heading">
      <h1>A new perspective on Earth.</h1>
      <p>{description}</p>
    </header>
  </EarthGlobe>
</BaseLayout>

<style>
  :global(.page-main:has(> earth-globe)) {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--space-8);
  }

  .globe-heading h1 {
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    font-weight: 550;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .globe-heading p {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
</style>
