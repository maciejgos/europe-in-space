---
import { getEntry } from "astro:content";
import { missionCategories } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Badge from "../../components/ui/Badge.astro";
import Icon from "../../components/ui/Icon.astro";

const mission = await getEntry("missions", "sentinel-2");
const missions = mission ? [mission] : [];
---

<BaseLayout title="European space missions">
  <PageHeader
    eyebrow="Mission explorer"
    title="European space missions"
    description="From our home planet to the far reaches of the Solar System. Get to know the missions expanding our horizons."
  />
  <div class="catalog-tools">
    <div class="chips" aria-label="Filter missions">
      {["All missions", ...missionCategories].map((n, i) => (
        <button
          type="button"
          class="chip"
          data-mission-filter={n}
          aria-pressed={i === 0}
        >
          {n}
        </button>
      ))}
    </div>
    <label>
      <span class="sr-only">Search missions</span>
      <input
        type="search"
        class="input catalog-search"
        placeholder="Search missions…"
        id="mission-query"
      />
    </label>
  </div>
  <div class="mission-grid">
    {missions.map(({ id, data: { title, summary, category, hero } }) => (
      <a
        href={`/missions/${id}/`}
        class="panel mission-card"
        data-mission-card
        data-category={category}
        data-search-text={`${title} ${category} ${summary}`.toLowerCase()}
      >
        <img src={hero.src} width={hero.width} height={hero.height} alt="" />
        <div class="mission-card-copy">
          <h2>{title}</h2>
          <p>{summary}</p>
          <div class="mission-card-foot">
            <Badge tone="accent">{category}</Badge>
            <Icon name="arrow-right" />
          </div>
        </div>
      </a>
    ))}
  </div>
  <div class="panel catalog-empty" hidden>
    <Icon name="compass" size={36} />
    <h2 style="margin-top:18px">No matching missions</h2>
    <p>Try a different category or search term.</p>
    <button type="button" class="button button--secondary" id="reset-missions">
      Show all missions
    </button>
  </div>
  <p class="catalog-note" role="status" id="mission-count">
    {missions.length} {missions.length === 1 ? "mission" : "missions"}
  </p>
</BaseLayout>
<script>
  let selected = "All missions";
  const input = document.querySelector<HTMLInputElement>("#mission-query");
  const filters = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-mission-filter]"),
  ];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-mission-card]")];
  const empty = document.querySelector<HTMLElement>(".catalog-empty");
  const count = document.getElementById("mission-count");
  const update = () => {
    const query = input?.value.trim().toLowerCase() || "";
    let visible = 0;
    for (const card of cards) {
      const matchesCategory = selected === "All missions" || card.dataset.category === selected;
      card.hidden = !matchesCategory || !card.dataset.searchText?.includes(query);
      if (!card.hidden) visible++;
    }
    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = `${visible} ${visible === 1 ? "mission" : "missions"}`;
    filters.forEach((b) =>
      b.setAttribute(
        "aria-pressed",
        String(b.dataset.missionFilter === selected),
      ),
    );
  };
  filters.forEach((b) =>
    b.addEventListener("click", () => {
      selected = b.dataset.missionFilter || "All missions";
      update();
    }),
  );
  input?.addEventListener("input", update);
  document.querySelector("#reset-missions")?.addEventListener("click", () => {
    selected = "All missions";
    if (input) input.value = "";
    update();
    filters[0]?.focus();
  });
</script>
