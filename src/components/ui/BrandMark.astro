---
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={["brand-mark", className]}
  aria-hidden="true"
>
  <defs>
    <radialGradient id="eis-planet-glow" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#86ccff" stop-opacity="0.35" />
      <stop offset="70%" stop-color="#58b6fa" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#58b6fa" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="eis-orbit-stroke" x1="4" y1="31" x2="36" y2="9" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#58b6fa" stop-opacity="0.25" />
      <stop offset="55%" stop-color="#86ccff" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#f4f6fa" stop-opacity="0.95" />
    </linearGradient>
  </defs>
  <circle cx="20" cy="20" r="10.5" fill="url(#eis-planet-glow)" stroke="#58b6fa" stroke-opacity="0.55" stroke-width="1.35" />
  <path
    d="M12.5 17.5C15.5 14.5 21 14 25.5 16.5"
    stroke="#86ccff"
    stroke-opacity="0.45"
    stroke-width="1.2"
    stroke-linecap="round"
  />
  <ellipse
    cx="20"
    cy="20"
    rx="17"
    ry="6.6"
    transform="rotate(-28 20 20)"
    stroke="url(#eis-orbit-stroke)"
    stroke-width="1.5"
    stroke-linecap="round"
  />
  <circle cx="32.4" cy="12.2" r="2.6" fill="#86ccff" />
  <circle cx="32.4" cy="12.2" r="4.6" fill="#58b6fa" fill-opacity="0.25" />
</svg>
