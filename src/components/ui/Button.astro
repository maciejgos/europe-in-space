---
import Icon from "./Icon.astro";
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "quiet";
  icon?: string;
  class?: string;
  type?: "button" | "submit";
  disabled?: boolean;
}
const {
  href,
  variant = "primary",
  icon,
  class: className,
  type = "button",
  disabled = false,
} = Astro.props;
---

{href ? (
  <a href={href} class:list={["button", `button--${variant}`, className]}>
    <slot />
    {icon && <Icon name={icon} size={20} />}
  </a>
) : (
  <button
    type={type}
    disabled={disabled}
    class:list={["button", `button--${variant}`, className]}
  >
    <slot />
    {icon && <Icon name={icon} size={20} />}
  </button>
)}
