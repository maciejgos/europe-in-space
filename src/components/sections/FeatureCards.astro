---
import Icon from "../ui/Icon.astro";
---

<div class="feature-grid">
  <a href="/missions/sentinel-2/" class="feature-card feature-card--mission">
    <img
      src="/images/sentinel-feature.webp"
      width="1942"
      height="809"
      alt=""
      loading="eager"
    />
    <div class="feature-content">
      <p class="eyebrow">Featured mission</p>
      <h2>Sentinel-2</h2>
      <p class="feature-description">Earth observation</p>
      <span class="card-link">
        <span class="round-icon">
          <Icon name="arrow-right" />
        </span>{" "}
        View mission
      </span>
    </div>
  </a>
  <a href="/satellites/" class="feature-card feature-card--orbits">
    <div class="feature-content">
      <p class="eyebrow">Explore orbits</p>
      <h2>
        Track European
        <br />
        spacecraft
      </h2>
      <p class="feature-description">
        A new perspective on
        <br />
        our planet.
      </p>
      <span class="card-link">
        <span class="round-icon">
          <Icon name="arrow-right" />
        </span>{" "}
        Explore orbits
      </span>
    </div>
    <img
      src="/images/orbit-globe.webp"
      width="640"
      height="640"
      alt=""
      class="orbit-art"
      loading="lazy"
    />
  </a>
  <a href="/data-sources/" class="feature-card feature-card--data">
    <div class="feature-content">
      <Icon name="stack" size={29} />
      <h2>
        Built on open
        <br />
        space data
      </h2>
      <p class="feature-description">
        Publicly available data from ESA, EUMETSAT, Copernicus, ESO and more.
      </p>
      <span class="card-link data-card-link">
        Meet the sources <Icon name="arrow-up-right" size={18} />
      </span>
    </div>
  </a>
</div>
