---
import { getEntry } from "astro:content";
import Icon from "../ui/Icon.astro";

const mission = await getEntry("missions", "sentinel-2");
const agencies = ["ESA", "Copernicus", "EUMETSAT", "ESO"];
---

<div class="feature-grid">
  {mission && (
    <a href={`/missions/${mission.id}/`} class="feature-card feature-card--mission">
      <img
        src={mission.data.hero.src}
        width={mission.data.hero.width}
        height={mission.data.hero.height}
        alt=""
        loading="eager"
      />
      <div class="feature-content">
        <p class="eyebrow">Featured mission</p>
        <h2>{mission.data.title}</h2>
        <p class="feature-description">{mission.data.category}</p>
        <span class="card-link">
          <span class="round-icon">
            <Icon name="arrow-right" />
          </span>{" "}
          View mission
        </span>
      </div>
    </a>
  )}
  <a href="/satellites/" class="feature-card feature-card--orbits">
    <div class="feature-content">
      <p class="eyebrow">Explore orbits</p>
      <h2>
        Track European
        <br />
        spacecraft
      </h2>
      <p class="feature-description">
        A new perspective on our planet.
      </p>
      <span class="card-link">
        <span class="round-icon">
          <Icon name="arrow-right" />
        </span>{" "}
        Explore orbits
      </span>
    </div>
    <div class="orbit-visual" aria-hidden="true">
      <img
        src="/images/orbit-globe.webp"
        width="640"
        height="640"
        alt=""
        class="orbit-art"
        loading="lazy"
      />
      <svg class="orbit-rings" viewBox="0 0 220 220" fill="none">
        <ellipse
          cx="110"
          cy="110"
          rx="92"
          ry="40"
          transform="rotate(-24 110 110)"
          stroke="#86ccff"
          stroke-opacity="0.34"
          stroke-width="1"
          stroke-dasharray="3 4"
        />
        <ellipse
          cx="110"
          cy="110"
          rx="86"
          ry="52"
          transform="rotate(34 110 110)"
          stroke="#58b6fa"
          stroke-opacity="0.45"
          stroke-width="1"
        />
        <circle cx="176" cy="64" r="3" fill="#f4f6fa" />
        <circle cx="176" cy="64" r="7" fill="#58b6fa" fill-opacity="0.28" />
        <circle cx="48" cy="146" r="2.4" fill="#86ccff" />
      </svg>
    </div>
  </a>
  <a href="/data-sources/" class="feature-card feature-card--data">
    <svg class="data-pattern" viewBox="0 0 280 240" fill="none" aria-hidden="true">
      <circle cx="235" cy="40" r="88" stroke="#58b6fa" stroke-opacity="0.1" stroke-width="1" />
      <circle cx="235" cy="40" r="56" stroke="#86ccff" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="3 4" />
      <circle cx="182" cy="18" r="2" fill="#86ccff" fill-opacity="0.45" />
      <circle cx="256" cy="92" r="2.5" fill="#58b6fa" fill-opacity="0.55" />
    </svg>
    <div class="feature-content">
      <div class="data-card-head">
        <Icon name="stack" size={27} />
        <div class="data-card-tags" aria-hidden="true">
          {agencies.map((name) => (
            <span>{name}</span>
          ))}
        </div>
      </div>
      <div class="data-card-body">
        <h2>
          Built on open
          <br />
          space data
        </h2>
        <p class="feature-description">
          Publicly available data from ESA, EUMETSAT, Copernicus, ESO and more.
        </p>
      </div>
      <span class="card-link data-card-link">
        <span class="round-icon round-icon--sm">
          <Icon name="arrow-up-right" size={16} />
        </span>
        Meet the sources
      </span>
    </div>
  </a>
</div>
