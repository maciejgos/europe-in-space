---
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SearchDialog from "../components/layout/SearchDialog.astro";
interface Props {
  title: string;
  description?: string;
  home?: boolean;
}
const {
  title,
  description = "Explore European space missions, spacecraft and the science shaping our understanding of Earth and beyond.",
  home = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050d17" />
    <link rel="icon" href="/icons/planet.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {home && <link rel="preload" href="/images/europe-night.webp" as="image" />}
    <title>{title} | Europe in Space</title>
  </head>
  <body class:list={[home ? "home-page" : "inner-page"]}>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class:list={[!home && "shell page-main"]}>
      <slot />
    </main>
    <SiteFooter />
    <SearchDialog />
  </body>
</html>
